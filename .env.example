# Example environment configuration — copy to .env or .local/.env and fill values.
# Never commit real tokens, private keys, or credentials to Git or Google Drive.

# --- Server & Ironic API ---
AGENTS_ENV=development
AGENTS_BIND_ADDR=0.0.0.0:8080
AGENTS_PUBLIC_URL=https://agents.example.com
AGENTS_TRUSTED_ORIGINS=https://app.example.com
AGENTS_API_GENERATION=1

# --- Authentication (Argon2id + JWT + Revocable Opaque Keys) ---
AGENTS_JWT_SECRET=
AGENTS_JWT_ACCESS_TTL_SECS=900
AGENTS_REFRESH_TTL_SECS=2592000
AGENTS_ADMIN_EMAIL=
AGENTS_ADMIN_INITIAL_PASSWORD=
AGENTS_CREDENTIAL_MASTER_KEY=

# --- PostgreSQL ---
DATABASE_URL=postgres://agents:change_me@127.0.0.1:5432/agents
DATABASE_MAX_CONNECTIONS=20

# --- Valkey (Redis-compatible state, locks & rate limiting) ---
VALKEY_URL=redis://127.0.0.1:6379
VALKEY_TLS=false

# --- NATS JetStream (Control Plane, Queues, Streams & Swarm) ---
NATS_URL=nats://127.0.0.1:4222
NATS_TLS_ENABLED=false
NATS_NKEY_SEED=
NATS_JWT=
NATS_CLUSTER_NAME=agents-cluster

# --- Boxer Daemon & Sandbox Runtime ---
BOXER_NODE_ID=boxer-local-01
BOXER_RUNTIME=docker
BOXER_ISOLATION=openshell
BOXER_OPENSHELL_GATEWAY_URL=
BOXER_SANDBOX_IMAGE=ghcr.io/natuleadan/agents-sandbox:latest
BOXER_MAX_CONCURRENT_BOXES=8
BOXER_WORKSPACE_ROOT=/var/lib/agents/boxes

# --- Traefik Ephemeral Preview Proxy ---
TRAEFIK_PREVIEW_ENABLED=true
TRAEFIK_PREVIEW_DOMAIN=preview.example.com
TRAEFIK_ACME_EMAIL=
TRAEFIK_VLAN_SUBNET=10.0.0.0/8

# --- LLM Providers (Optional host/proxy overrides; never hardcode in client) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPINFRA_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Third-Party Sandbox Providers (Client Third-Party Mode) ---
UPSTASH_BOX_API_KEY=
DAYTONA_API_KEY=
DAYTONA_API_URL=
INSTABOX_API_KEY=

# --- Cloud VPS Provisioning & Ephemeral E2E Testing ---
VPS_PROVIDER_API_KEY=
VPS_PROVIDER_PROJECT_ID=
VPS_PROVIDER_VLAN_ID=
VPS_PROVIDER_REGION=
VPS_PROVIDER_PLAN=
VPS_PROVIDER_SSH_KEY_PATH=.local/id_ed25519

# --- Observability (OpenTelemetry) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agents-server
RUST_LOG=info,agents_server=debug,agents_boxer=debug
